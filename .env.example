# ============================================================
# Cancer Genomic Intelligence: environment configuration
# Copy to `server/.env` and fill in values. Never commit real secrets.
# Only variables prefixed with VITE_ are exposed to the browser.
# ============================================================

# --- Core -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Browser origin allowed by CORS and used for cookie settings.
CLIENT_URL=http://localhost:5173
# Optional: path to the built client. In production the server finds client/dist on its own and
# serves the website and API from one address (needed for login cookies; see docs/deployment.md).
# CLIENT_DIST=

# --- Database ---------------------------------------------------------
# Example for local Docker: docker run -d -p 27017:27017 --name cgi-mongo mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017/cancer-genomic-intelligence

# --- Sessions ---------------------------------------------------------
# Required, at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# --- AI provider (optional) -------------------------------------------
# The app works without AI: search and evidence display are deterministic.
# AI_PROVIDER: none | anthropic
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
# Sending report-derived content to an external AI provider is OFF by default.
# Set to true only after an explicit privacy review.
AI_ALLOW_SENSITIVE_CONTENT=false

# --- NCBI E-utilities (ClinVar, PubMed) -------------------------------
# Optional. Raises the rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
# Identify your application to NCBI (recommended by their usage policy).
NCBI_TOOL=cancer-genomic-intelligence
NCBI_EMAIL=
NCBI_TIMEOUT_MS=15000

# --- CIViC ------------------------------------------------------------
CIVIC_TIMEOUT_MS=20000

# --- ClinicalTrials.gov -----------------------------------------------
CLINICALTRIALS_TIMEOUT_MS=15000

# --- External call policy ---------------------------------------------
EXTERNAL_MAX_RETRIES=2
EXTERNAL_RETRY_BASE_MS=400

# --- Public-source cache (never used for uploaded report content) -----
CACHE_TTL_CLINVAR_SECONDS=86400
CACHE_TTL_CIVIC_SECONDS=86400
CACHE_TTL_PUBMED_SECONDS=604800
CACHE_TTL_TRIALS_SECONDS=21600

# --- Rate limiting ----------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Client (public values only) --------------------------------------
# Put these in client/.env if you need to override the defaults.
# VITE_API_BASE_URL=/api
